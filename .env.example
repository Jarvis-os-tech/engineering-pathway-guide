# ==============================================================================
# DISHA (दिशा) — Environment Variables & API Configuration
# ==============================================================================
# Copy this file to .env locally:
#   cp .env.example .env
#
# FOR VERCEL DEPLOYMENTS:
#   1. Go to your Vercel Dashboard -> Project -> Settings -> Environment Variables
#   2. Add NEXT_PUBLIC_API_KEY with your Google Gemini API key
#   3. Select environments: Production, Preview, Development
#   4. Redeploy your latest deployment to apply the new keys!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRIMARY API KEY: GOOGLE GEMINI (PUBLIC API KEY)
# ------------------------------------------------------------------------------
# Public API key = Google Gemini API key
# Get your free or paid Gemini API key at: https://aistudio.google.com/app/apikey
NEXT_PUBLIC_API_KEY=AIzaSyYourGeminiApiKeyHere

# Dedicated Gemini environment variables (also supported by Disha):
NEXT_PUBLIC_GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Optional Gemini model override (default: gemini-2.5-flash)
# Supported options: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Optional Gemini base URL (OpenAI-compatible REST endpoint)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ------------------------------------------------------------------------------
# 2. ALTERNATIVE PROVIDER: OPENAI
# ------------------------------------------------------------------------------
# Get your OpenAI API key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-YourOpenAiApiKeyHere
# NEXT_PUBLIC_OPENAI_API_KEY=sk-proj-YourOpenAiApiKeyHere

# Optional OpenAI model override (default: gpt-4o)
# Supported options: gpt-4o, gpt-4o-mini, gpt-4-turbo
# OPENAI_MODEL=gpt-4o

# Optional OpenAI base URL
# OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# 3. PROVIDER SELECTION (Optional)
# ------------------------------------------------------------------------------
# Choose provider priority if multiple keys are provided:
# Options: gemini (default) | openai | lovable
AI_PROVIDER=gemini

# ------------------------------------------------------------------------------
# 4. LOVABLE AI GATEWAY (For Lovable in-editor development)
# ------------------------------------------------------------------------------
# Automatically provisioned when running inside the Lovable web environment.
# LOVABLE_API_KEY=your_lovable_api_key_here
# LOVABLE_MODEL=openai/gpt-6-astra
# LOVABLE_BASE_URL=https://ai.gateway.lovable.dev/v1

# ------------------------------------------------------------------------------
# 5. APPLICATION & CHAT CONTROLS
# ------------------------------------------------------------------------------
# Max conversation turns to keep in context memory (default: 60)
CHAT_MAX_MESSAGES=60

# Optional custom chat API endpoint route (default: /api/chat)
# NEXT_PUBLIC_CHAT_API_URL=/api/chat
