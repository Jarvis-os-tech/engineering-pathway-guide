# ==============================================================================
# DISHA (दिशा) — Environment Variables & API Configuration
# ==============================================================================
# Copy this file to .env locally:
#   cp .env.example .env
#
# FOR VERCEL DEPLOYMENTS:
#   1. Go to your Vercel Dashboard -> Select project -> Settings -> Environment Variables
#   2. Add your chosen API key (e.g., GEMINI_API_KEY or NEXT_PUBLIC_API_KEY or OPENAI_API_KEY)
#   3. Select environments: Production, Preview, Development
#   4. Redeploy your latest deployment to apply the new keys!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI API (Recommended: High speed, low cost, excellent for Indian counselling)
# ------------------------------------------------------------------------------
# Get your free/paid Gemini API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Optional Gemini model override (default: gemini-2.5-flash)
# Supported options: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Optional Gemini base URL (OpenAI-compatible REST endpoint)
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ------------------------------------------------------------------------------
# 2. OPENAI API (Alternative provider)
# ------------------------------------------------------------------------------
# Get your OpenAI API key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-YourOpenAiApiKeyHere

# Optional OpenAI model override (default: gpt-4o)
# Supported options: gpt-4o, gpt-4o-mini, gpt-4-turbo
# OPENAI_MODEL=gpt-4o

# Optional OpenAI base URL
# OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# 3. UNIVERSAL / VERCEL NEXT_PUBLIC FALLBACK KEYS
# ------------------------------------------------------------------------------
# If you prefer using universal variable names in Vercel, Disha also recognizes:
# NEXT_PUBLIC_API_KEY=AIzaSy... (Auto-detected as Gemini) OR sk-... (Auto-detected as OpenAI)
# NEXT_PUBLIC_GEMINI_API_KEY=AIzaSy...
# NEXT_PUBLIC_OPENAI_API_KEY=sk-...

# ------------------------------------------------------------------------------
# 4. PROVIDER OVERRIDE (Optional)
# ------------------------------------------------------------------------------
# Force a specific provider if you have multiple keys defined:
# Options: gemini | openai | lovable
# AI_PROVIDER=gemini

# ------------------------------------------------------------------------------
# 5. LOVABLE AI GATEWAY (For Lovable in-editor development)
# ------------------------------------------------------------------------------
# Automatically provisioned when running inside the Lovable web environment.
# LOVABLE_API_KEY=your_lovable_api_key_here
# LOVABLE_MODEL=openai/gpt-6-astra
# LOVABLE_BASE_URL=https://ai.gateway.lovable.dev/v1

# ------------------------------------------------------------------------------
# 6. APPLICATION & CHAT CONTROLS
# ------------------------------------------------------------------------------
# Max conversation turns to keep in context memory (default: 60)
CHAT_MAX_MESSAGES=60

# Optional custom chat API endpoint route (default: /api/chat)
# NEXT_PUBLIC_CHAT_API_URL=/api/chat
